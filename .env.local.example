NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Escolha uma: Groq (gratuito e recomendado), OpenAI ou Ollama Cloud
USE_GROQ=true

# Para Groq (gratuito e recomendado)
GROQ_API_KEY=your_groq_api_key

# Para OpenAI (alternativa)
USE_OPENAI=false
OPENAI_API_KEY=your_openai_api_key

# Para Ollama Cloud (alternativa)
OLLAMA_CLOUD_API_KEY=your_ollama_cloud_api_key
OLLAMA_CLOUD_URL=https://api.ollama.cloud
